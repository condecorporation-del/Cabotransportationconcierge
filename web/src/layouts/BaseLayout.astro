---
import FloatingActions from "../components/FloatingActions.astro";
import Motion from "../components/Motion.astro";
import Seo from "../components/Seo.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE, UI, type Locale } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  image?: string | undefined;
}

const { title, description, locale = SITE.defaultLocale, image } = Astro.props;
const t = UI[locale];

// La ruta sale de la URL de la página, no de una prop: así ninguna página puede declarar mal
// su canonical, y el `hreflang` se arma solo. Se le quita el prefijo de idioma para que las
// dos versiones compartan la misma ruta lógica (D15).
const path = Astro.url.pathname.replace(/^\/es(?=\/|$)/, "") || "/";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} path={path} locale={locale} image={image} />
    <!-- Solo las dos variantes del primer pantallazo (§3.5.6); el resto llega con swap. -->
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Para el preload de la imagen LCP de una página en particular (el poster del hero, F7.7);
         vacío en el resto. -->
    <slot name="head" />
    <!-- Sin JavaScript, [data-reveal] (F7.8) se queda visible: solo `Motion.astro` le agrega la
         clase `.is-in` que lo revela, y sin script esa clase nunca llega. -->
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Motion />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-pearl"
    >
      {t.skipToContent}
    </a>
    <SiteHeader locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <FloatingActions locale={locale} />
  </body>
</html>

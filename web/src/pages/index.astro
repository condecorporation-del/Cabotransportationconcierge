---
import BuildStamp from "../components/BuildStamp";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Cabo Transportation Concierge"
  description="Private airport transfers and chauffeur service in Los Cabos: fixed rates by zone, flight tracking and a driver waiting when you land."
>
  <!-- Placeholder de F7.1-F7.3: ejercita los tokens y el layout. Las secciones del prototipo
       aprobado llegan en F7.6. -->
  <div class="mx-auto max-w-(--container-site) px-(--spacing-gutter) py-(--spacing-section)">
    <p
      class="font-brand text-label tracking-(--tracking-brand) text-gold uppercase"
      data-token="brand"
    >
      Cabo Transportation Concierge
    </p>
    <h1
      class="font-display tracking-(--tracking-display) mt-6 text-h1 leading-[1.08] text-pearl"
      data-token="display"
    >
      Where is your journey taking you?
    </h1>
    <p class="mt-5 max-w-(--container-prose) text-lead text-stone" data-token="body">
      Private transfers from Los Cabos International, with your chauffeur waiting before you land.
    </p>
    <p class="mt-10">
      <BuildStamp client:load />
    </p>
  </div>
</BaseLayout>

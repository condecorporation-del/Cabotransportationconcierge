---
import { getCompany } from "../lib/company";
import { UI, type Locale } from "../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI[locale];

// El agente Customer Help es F10; aquí queda su disparador, deshabilitado mientras no exista,
// para no ofrecer un botón que no hace nada. WhatsApp solo aparece si hay número real en
// `company_settings` (D-P4): mandar a la gente a un número inventado sería peor que no mostrarlo.
const company = await getCompany();
---

<div class="fixed right-4 bottom-4 z-50 flex flex-col gap-3" data-floating-actions>
  {company.whatsappE164 && (
    <a
      href={`https://wa.me/${company.whatsappE164}`}
      class="font-brand text-label tracking-(--tracking-label) border border-gold-dark bg-ink px-4 py-3 text-gold-light uppercase"
      rel="noopener"
    >
      {t.whatsapp}
    </a>
  )}
  <button
    type="button"
    class="font-brand text-label tracking-(--tracking-label) cursor-not-allowed border border-gold-dark bg-ink px-4 py-3 text-stone uppercase"
    disabled
    data-customer-help
  >
    {t.customerHelp}
  </button>
</div>

<style is:global>
  /* Con el menú móvil abierto, los flotantes taparían el "Reservar" de abajo (§3.5.6: los
     flotantes no deben tapar CTAs). Es global porque mira el <details> del header. */
  body:has([data-mobile][open]) [data-floating-actions] {
    display: none;
  }
</style>

# development | test | staging | production
ENVIRONMENT=development

# Local: postgresql+asyncpg://postgres:<PGPASSWORD>@localhost:5432/ctc
# Staging/producción: Session Pooler de Supabase (puerto 5432, SSL). Nunca la anon key.
DATABASE_URL=

# Conexión Direct de Supabase, solo para Alembic (vacía = usa DATABASE_URL)
DATABASE_URL_DIRECT=

# Base separada solo para pytest: postgresql+asyncpg://postgres:<PGPASSWORD>@localhost:5432/ctc_test
TEST_DATABASE_URL=

# Cloudflare Turnstile (formularios públicos). Local vacía = no se exige; obligatoria en producción.
TURNSTILE_SECRET_KEY=

# Empresa que atiende el sitio público (slug de scripts/data/catalog.json)
DEFAULT_COMPANY_SLUG=cabo-transportation-concierge

# Firma los enlaces de gestión del cliente. Local vacía = clave aleatoria por arranque.
# Obligatoria en staging/producción (mínimo 32 caracteres):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

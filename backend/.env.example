# development | test | staging | production
ENVIRONMENT=development

# Local: postgresql+asyncpg://postgres:<PGPASSWORD>@localhost:5432/ctc
# Staging/producción: Session Pooler de Supabase (puerto 5432, SSL). Nunca la anon key.
DATABASE_URL=

# Base separada solo para pytest: postgresql+asyncpg://postgres:<PGPASSWORD>@localhost:5432/ctc_test
TEST_DATABASE_URL=

# Obligatoria en staging/producción (mínimo 32 caracteres):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
